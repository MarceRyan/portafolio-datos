---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/casos/CaseCard.astro';
import { categoryLabels, type CasoCategory } from '../../data/categories';
import { getCasos } from '../../data/casos';

const casos = await getCasos();

const present = (Object.keys(categoryLabels) as CasoCategory[]).filter((category) =>
  casos.some((caso) => caso.data.category === category),
);
---

<BaseLayout
  title="Casos"
  description="Proyectos de datos que construí: tableros, automatizaciones e ingeniería de datos."
>
  <section class="wrap pt-12 pb-20 sm:pt-16 sm:pb-28">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Casos</h1>
    <p class="mt-5 max-w-[56ch] text-lg text-body">
      Cada caso parte de una pregunta de negocio y termina en lo que se pudo decidir con los datos.
    </p>

    <div
      role="group"
      aria-label="Filtrar por categoría"
      class="mt-10 flex flex-wrap gap-2"
      data-case-filters
    >
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="filter-chip inline-flex min-h-11 items-center gap-2 rounded-ui border border-soft px-4 text-sm font-semibold text-ink transition-[background-color,transform] duration-150 ease-out hover:bg-surface active:scale-[0.97] aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-bg"
      >
        Todos
        <span class="tabular-nums">{casos.length}</span>
      </button>
      {present.map((category) => (
        <button
          type="button"
          data-filter={category}
          aria-pressed="false"
          class="filter-chip inline-flex min-h-11 items-center gap-2 rounded-ui border border-soft px-4 text-sm font-semibold text-ink transition-[background-color,transform] duration-150 ease-out hover:bg-surface active:scale-[0.97] aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-bg"
        >
          {categoryLabels[category]}
          <span class="tabular-nums">
            {casos.filter((caso) => caso.data.category === category).length}
          </span>
        </button>
      ))}
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

    <ul data-cases class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {casos.map((caso) => (
        <li data-category={caso.data.category} class="flex">
          <CaseCard caso={caso} transitionName={`cover-${caso.data.slug}`} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  import '../../scripts/case-filter';
</script>
