---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperienceTimeline from '../../components/experience/ExperienceTimeline.astro';
import ExperienceCards from '../../components/experience/ExperienceCards.astro';
import ExperienceHorizontal from '../../components/experience/ExperienceHorizontal.astro';

// TODO(marcelo): página temporal para elegir una propuesta. Se elimina al decidir.
const proposals = [
  {
    id: 'a',
    name: 'Propuesta A: línea de tiempo vertical',
    note: 'Cuenta el recorrido de arriba abajo. El cargo actual destaca en grande y la formación queda fija a un lado mientras bajas.',
  },
  {
    id: 'b',
    name: 'Propuesta B: tarjetas por rol',
    note: 'Mosaico donde cada puesto tiene su tamaño, su año en grande y sus herramientas. Más ordenado y fácil de escanear.',
  },
  {
    id: 'c',
    name: 'Propuesta C: línea de tiempo horizontal interactiva',
    note: 'Eliges un año y se despliega el detalle. Recorre tu camino de izquierda a derecha, como los datos en el motor de decisiones.',
  },
] as const;
---

<BaseLayout
  title="Propuestas de experiencia"
  description="Tres propuestas visuales para la experiencia laboral y la formación."
  noindex
>
  <div class="wrap py-16 sm:py-20">
    <h1 class="max-w-[22ch] text-4xl font-extrabold sm:text-5xl">
      Tres propuestas para tu experiencia
    </h1>
    <p class="mt-5 max-w-[62ch] text-lg text-body">
      Misma información real en tres formas distintas. Revisa cada una en escritorio y en el
      teléfono, y dime cuál prefieres.
    </p>
    <ul class="mt-8 flex flex-wrap gap-3 text-sm font-medium text-ink">
      {proposals.map((p) => (
        <li>
          <a
            href={`#${p.id}`}
            class="inline-flex min-h-11 items-center rounded-ui border border-soft px-4 hover:bg-surface"
          >
            {p.name.split(':')[0]}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <section id="a" class="border-y border-line bg-surface py-20">
    <div class="wrap">
      <h2 class="text-3xl font-extrabold">{proposals[0].name}</h2>
      <p class="mt-3 max-w-[62ch] text-body">{proposals[0].note}</p>
      <div class="mt-14">
        <ExperienceTimeline />
      </div>
    </div>
  </section>

  <section id="b" class="py-20">
    <div class="wrap">
      <h2 class="text-3xl font-extrabold">{proposals[1].name}</h2>
      <p class="mt-3 max-w-[62ch] text-body">{proposals[1].note}</p>
      <div class="mt-14">
        <ExperienceCards />
      </div>
    </div>
  </section>

  <section id="c" class="border-y border-line bg-surface py-20">
    <div class="wrap">
      <h2 class="text-3xl font-extrabold">{proposals[2].name}</h2>
      <p class="mt-3 max-w-[62ch] text-body">{proposals[2].note}</p>
      <div class="mt-14">
        <ExperienceHorizontal />
      </div>
    </div>
  </section>
</BaseLayout>
