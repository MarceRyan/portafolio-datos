---
import { render } from 'astro:content';
import CasoLayout from '../../layouts/CasoLayout.astro';
import { getCasos } from '../../data/casos';

export async function getStaticPaths() {
  const casos = await getCasos();
  return casos.map((caso, index) => ({
    params: { slug: caso.data.slug },
    props: {
      caso,
      prev: casos[(index - 1 + casos.length) % casos.length],
      next: casos[(index + 1) % casos.length],
      position: index + 1,
      total: casos.length,
    },
  }));
}

const { caso, prev, next, position, total } = Astro.props;
const { Content } = await render(caso);
---

<CasoLayout caso={caso} prev={prev} next={next} position={position} total={total}>
  <Content />
</CasoLayout>
