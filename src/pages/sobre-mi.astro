---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ExperienceExplorer from '../components/experience/ExperienceExplorer.astro';
import Community from '../components/home/Community.astro';
import Now from '../components/home/Now.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Sobre mí"
  description="Mi recorrido profesional, la comunidad en la que participo y lo que hago hoy."
>
  <section class="wrap pt-12 pb-16 sm:pt-16 sm:pb-20">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Sobre mí</h1>
    <p class="mt-6 max-w-[62ch] text-xl leading-relaxed text-body">
      Soy {site.fullName}, analista de datos desde enero de 2025. Mi recorrido empezó en logística y
      administración, pasó por TI y soporte técnico en Pasco, y llegó a los datos con un servicio de
      Mesa de Ayuda en octubre de 2024.
    </p>
    <p class="mt-5 max-w-[62ch] text-xl leading-relaxed text-body">
      Tengo más de 2 años de experiencia en análisis, automatización y visualización de datos, y
      busco puestos de Analista de Datos, Analista BI y Ingeniero de Datos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/casos">Ver casos</Button>
      <Button href={site.cvPath} variant="secondary" download>
        <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
        Descargar CV
      </Button>
    </div>
  </section>

  <section aria-labelledby="recorrido-title" class="border-y border-line bg-surface py-20 sm:py-24">
    <div class="wrap">
      <h2 id="recorrido-title" class="text-3xl font-extrabold sm:text-4xl">
        Trayectoria
      </h2>
      <div class="mt-12">
        <ExperienceExplorer />
      </div>
    </div>
  </section>

  <Community />

  <Now />
</BaseLayout>
