---
// Página temporal para comparar dos diseños de la experiencia.
// TODO(marcelo): elegir una opción; después se integra en la portada y /sobre-mi y se borra esta página.
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceList from '../components/experience/ExperienceList.astro';
import ExperienceAccordion from '../components/experience/ExperienceAccordion.astro';
---

<BaseLayout title="Laboratorio de experiencia" noindex>
  <section class="wrap pt-12 pb-10 sm:pt-16">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Dos formas de mostrar la experiencia</h1>
    <p class="mt-5 max-w-[62ch] text-lg text-body">
      Las dos muestran todos los puestos sin desplazarse hacia los lados.
    </p>
  </section>

  <section class="border-y border-line bg-surface py-16">
    <div class="wrap">
      <h2 class="mb-10 text-2xl font-extrabold">
        <span class="text-decide">A</span> Lista con detalle al lado
      </h2>
      <ExperienceList />
    </div>
  </section>

  <section class="py-16">
    <div class="wrap">
      <h2 class="mb-10 text-2xl font-extrabold">
        <span class="text-decide">B</span> Acordeón
      </h2>
      <ExperienceAccordion />
    </div>
  </section>
</BaseLayout>
