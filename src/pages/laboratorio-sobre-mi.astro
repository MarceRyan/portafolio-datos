---
// Página temporal para comparar estilos de "Sobre mí".
// TODO(marcelo): elegir una opción; después se integra en la portada y se borra esta página.
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutCard from '../components/about-lab/AboutCard.astro';
import AboutChapters from '../components/about-lab/AboutChapters.astro';
import AboutBento from '../components/about-lab/AboutBento.astro';

const options = [
  { letter: 'A', name: 'Relato y ficha', Component: AboutCard },
  { letter: 'B', name: 'Tres capítulos', Component: AboutChapters },
  { letter: 'C', name: 'Mosaico de bloques', Component: AboutBento },
];
---

<BaseLayout title="Laboratorio de Sobre mí" noindex>
  {options.map(({ letter, name, Component }) => (
    <section class="border-b border-line bg-surface py-16">
      <div class="wrap">
        <p class="mb-8 text-2xl font-extrabold text-ink">
          <span class="text-decide">{letter}</span> {name}
        </p>
        <h2 class="mb-8 text-3xl font-extrabold sm:text-4xl">Sobre mí</h2>
        <Component />
      </div>
    </section>
  ))}
</BaseLayout>
