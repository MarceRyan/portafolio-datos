---
// Página temporal para comparar tres diseños del voluntariado.
// TODO(marcelo): elegir una opción; después se integra y se borra esta página.
import BaseLayout from '../layouts/BaseLayout.astro';
import VolunteerEditorial from '../components/community/VolunteerEditorial.astro';
import VolunteerBadge from '../components/community/VolunteerBadge.astro';
import VolunteerFlow from '../components/community/VolunteerFlow.astro';
---

<BaseLayout title="Laboratorio de voluntariado" noindex>
  <section class="wrap pt-12 pb-6 sm:pt-16">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Tres formas de mostrar el voluntariado</h1>
  </section>

  <section class="wrap py-16">
    <h2 class="mb-10 text-2xl font-extrabold">
      <span class="text-decide">A</span> Editorial
    </h2>
    <VolunteerEditorial />
  </section>

  <section class="border-y border-line bg-bg py-16">
    <div class="wrap">
      <h2 class="mb-10 text-2xl font-extrabold">
        <span class="text-decide">B</span> Ficha y mosaico
      </h2>
      <VolunteerBadge />
    </div>
  </section>

  <section class="wrap py-16">
    <h2 class="mb-10 text-2xl font-extrabold">
      <span class="text-decide">C</span> Flujo de una sesión
    </h2>
    <VolunteerFlow />
  </section>
</BaseLayout>

<script>
  import '../scripts/community-line';
</script>
