---
// Página temporal para comparar alternativas al motor de decisiones.
// TODO(marcelo): elegir una variante; después se integra en la portada y se borra esta página.
import BaseLayout from '../layouts/BaseLayout.astro';
import { stages } from '../data/tools';

const options = [
  {
    id: 'streams',
    letter: 'A',
    title: 'Corrientes',
    text: 'Hilos dispersos que se ordenan en carriles al pasar por Transformación y se unen en la Decisión. Por cada hilo viaja un destello.',
  },
  {
    id: 'blocks',
    letter: 'B',
    title: 'De registros a gráfico',
    text: 'Registros sueltos que giran, se alinean como filas de una tabla, se agrupan en el Modelado y terminan apilados en un gráfico de barras.',
  },
  {
    id: 'signal',
    letter: 'C',
    title: 'Señal',
    text: 'Una lectura ruidosa que se va limpiando hasta ser una onda clara y llega a la Decisión como una sola línea. El nodo late con cada cresta.',
  },
];
---

<BaseLayout title="Laboratorio del motor" noindex>
  <section class="wrap pt-12 pb-20 sm:pt-16">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Alternativas para el motor</h1>
    <p class="mt-5 max-w-[62ch] text-lg text-body">
      Tres animaciones para el centro de "Así llega un dato a una decisión". Se ven en pantallas
      desde 768 px de ancho.
    </p>

    <div class="mt-14 flex flex-col gap-20">
      {options.map((option) => (
        <article>
          <h2 class="text-2xl font-extrabold">
            <span class="text-decide">{option.letter}</span> {option.title}
          </h2>
          <p class="mt-3 max-w-[62ch] text-body">{option.text}</p>
          <ol class="mt-8 hidden grid-cols-5 md:grid">
            {stages.map((stage, index) => (
              <li class="pr-4 font-display text-lg font-bold text-ink">
                <span class="text-soft tabular-nums">{index + 1}</span> {stage.name}
              </li>
            ))}
          </ol>
          <div aria-hidden="true" class="relative mt-3 hidden h-44 md:block">
            <canvas data-lab-variant={option.id} class="absolute inset-0 size-full" />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/engine-lab';
</script>
