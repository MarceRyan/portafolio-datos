---
// Página temporal para comparar tipografías.
// TODO(marcelo): elegir una combinación; después se aplica a todo el sitio y se borra esta página.
import '@fontsource/bricolage-grotesque/latin-500.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/hanken-grotesk/latin-400.css';
import '@fontsource/hanken-grotesk/latin-600.css';
import '@fontsource/unbounded/latin-500.css';
import '@fontsource/unbounded/latin-700.css';
import '@fontsource/unbounded/latin-800.css';
import '@fontsource/geologica/latin-400.css';
import '@fontsource/geologica/latin-600.css';
import '@fontsource/sora/latin-500.css';
import '@fontsource/sora/latin-700.css';
import '@fontsource/sora/latin-800.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import BaseLayout from '../layouts/BaseLayout.astro';

const options = [
  {
    letter: 'Actual',
    name: 'Schibsted Grotesk + Instrument Sans',
    note: 'La que tienes hoy, como referencia.',
    display: "'Schibsted Grotesk'",
    body: "'Instrument Sans'",
    numbers: "'Schibsted Grotesk'",
  },
  {
    letter: 'A',
    name: 'Bricolage Grotesque + Hanken Grotesk',
    note: 'Títulos con carácter, un poco irregulares y cercanos. Texto limpio y fácil de leer.',
    display: "'Bricolage Grotesque'",
    body: "'Hanken Grotesk'",
    numbers: "'Bricolage Grotesque'",
  },
  {
    letter: 'B',
    name: 'Unbounded + Geologica',
    note: 'Títulos anchos y tecnológicos, muy reconocibles. Texto geométrico y moderno.',
    display: "'Unbounded'",
    body: "'Geologica'",
    numbers: "'Unbounded'",
  },
  {
    letter: 'C',
    name: 'Sora + IBM Plex Sans + IBM Plex Mono',
    note: 'Aire de ingeniería: títulos geométricos, texto técnico y números en tipografía de código.',
    display: "'Sora'",
    body: "'IBM Plex Sans'",
    numbers: "'IBM Plex Mono'",
    numberWeight: 'font-bold',
  },
];
---

<BaseLayout title="Laboratorio de tipografía" noindex>
  <section class="wrap pt-12 pb-6 sm:pt-16">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Tipografías para el portafolio</h1>
    <p class="mt-4 max-w-[62ch] text-lg text-body">
      Cada bloque usa textos reales del sitio con una combinación distinta.
    </p>
  </section>

  {options.map((option, index) => (
    <section
      class:list={['py-14', index % 2 === 1 && 'border-y border-line bg-surface']}
      style={`--fd:${option.display};--fb:${option.body};--fn:${option.numbers}`}
    >
      <div class="wrap">
        <p class="text-sm font-semibold text-soft">
          <span class="text-decide">{option.letter}</span> · {option.name}
        </p>
        <p class="mt-1 max-w-[62ch] text-sm text-body">{option.note}</p>

        <div class="mt-8 grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
          <div>
            <p class="font-[family-name:var(--fd)] text-5xl leading-[1.02] font-extrabold tracking-tight text-ink sm:text-6xl">
              Marcelo Morales Rimac
            </p>
            <p class="mt-5 font-[family-name:var(--fd)] text-2xl leading-snug font-bold text-ink sm:text-3xl">
              Convierto datos desordenados en decisiones claras.
            </p>
            <p class="mt-5 max-w-[60ch] font-[family-name:var(--fb)] text-lg text-body">
              Analista de datos. Extraigo, limpio, modelo y visualizo información para que las
              gerencias decidan con evidencia.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 font-[family-name:var(--fb)]">
              <span class="inline-flex min-h-11 items-center rounded-ui bg-ink px-5 font-semibold text-bg">
                Ver proyectos
              </span>
              <span class="inline-flex min-h-11 items-center rounded-ui border border-soft px-5 font-semibold text-ink">
                Descargar CV
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-6">
            <div>
              <p class="font-[family-name:var(--fd)] text-3xl font-extrabold text-ink">
                Cómo trabajo
              </p>
              <ol class="mt-3 grid grid-cols-5 gap-2 font-[family-name:var(--fd)] text-sm font-bold text-ink">
                <li>1 Encontrar</li>
                <li>2 Recolectar</li>
                <li>3 Limpiar</li>
                <li>4 Ordenar</li>
                <li>5 Decidir</li>
              </ol>
            </div>
            <div class="flex items-end gap-4">
              <span
                class:list={[
                  'font-[family-name:var(--fn)] text-6xl leading-none text-decide',
                  option.numberWeight ?? 'font-black',
                ]}
              >
                37.15%
              </span>
              <span class="pb-1 font-[family-name:var(--fb)] text-sm text-body">
                de logro nacional en 2025
              </span>
            </div>
            <p class="font-[family-name:var(--fb)] text-body">
              Tablero de seguimiento del programa Competencia Lectora · Python, SQL Server, Power BI
            </p>
          </div>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
