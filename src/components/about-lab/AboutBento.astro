---
// Opción C: mosaico de bloques de distinto tamaño (relato, hoy, aprendiendo, tecnologías y CV).
import { Icon } from 'astro-icon/components';
import ToolChips from '../ui/ToolChips.astro';
import { about } from '../../data/about';
import { site } from '../../data/site';
import { resolveTools } from '../../data/tool-refs';

const tile = 'rounded-ui border border-line bg-bg p-6';
---

<div class="grid gap-4 lg:grid-cols-6">
  <div class:list={[tile, 'lg:col-span-4']}>
    <p class="font-display text-2xl leading-snug font-bold text-ink sm:text-3xl">
      {about.headline}
    </p>
    <p class="mt-4 text-lg leading-relaxed text-body">{about.story}</p>
  </div>

  <div class:list={[tile, 'flex flex-col justify-between gap-6 bg-ink text-bg lg:col-span-2']}>
    <Icon name="ph:file-arrow-down-fill" class="size-10 text-clean" aria-hidden="true" />
    <div>
      <p class="font-display text-xl font-extrabold text-bg">Mi CV completo</p>
      <p class="mt-1 text-sm opacity-80">Experiencia, formación y certificados en un PDF.</p>
      <a
        href={site.cvPath}
        download
        class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-bg underline underline-offset-4"
      >
        <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
        Descargar CV
      </a>
    </div>
  </div>

  <div class:list={[tile, 'lg:col-span-3']}>
    <p class="flex items-center gap-2 text-sm font-semibold text-clean">
      <Icon name="ph:chart-line-up-fill" class="size-5" aria-hidden="true" />
      Qué hago hoy
    </p>
    <p class="mt-3 leading-relaxed text-body">{about.today}</p>
  </div>

  <div class:list={[tile, 'lg:col-span-3']}>
    <p class="flex items-center gap-2 text-sm font-semibold text-decide">
      <Icon name="ph:sparkle-fill" class="size-5" aria-hidden="true" />
      Sigo aprendiendo
    </p>
    <p class="mt-3 leading-relaxed text-body">{about.learning}</p>
  </div>

  <div class:list={[tile, 'lg:col-span-6']}>
    <p class="text-sm font-semibold text-soft">Tecnologías con las que trabajo</p>
    <ToolChips tools={resolveTools(about.tech)} class="mt-3" />
  </div>
</div>
