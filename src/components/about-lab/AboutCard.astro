---
// Opción A: relato a la izquierda y una ficha con datos rápidos y el CV a la derecha.
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import ToolChips from '../ui/ToolChips.astro';
import { about } from '../../data/about';
import { site } from '../../data/site';
import { resolveTools } from '../../data/tool-refs';
---

<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14">
  <div class="max-w-[62ch]">
    <p class="font-display text-2xl leading-snug font-bold text-ink sm:text-3xl">
      {about.headline}
    </p>
    <div class="mt-6 flex flex-col gap-4 text-lg leading-relaxed text-body">
      <p>{about.story}</p>
      <p>{about.today}</p>
      <p>{about.learning}</p>
    </div>
  </div>

  <aside class="flex flex-col gap-6 rounded-ui border border-line bg-bg p-6 lg:self-start">
    <dl class="flex flex-col gap-5">
      {about.facts.map((fact) => (
        <div class="flex gap-3">
          <Icon name={fact.icon} aria-hidden="true" class="mt-0.5 size-5 shrink-0 text-clean" />
          <div>
            <dt class="text-sm font-semibold text-soft">{fact.label}</dt>
            <dd class="mt-0.5 font-medium text-ink">{fact.value}</dd>
          </div>
        </div>
      ))}
    </dl>
    <div class="border-t border-line pt-5">
      <p class="text-sm font-semibold text-soft">Tecnologías con las que trabajo</p>
      <ToolChips tools={resolveTools(about.tech)} variant="icons" class="mt-3" />
    </div>
    <Button href={site.cvPath} download>
      <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
      Descargar CV
    </Button>
  </aside>
</div>
