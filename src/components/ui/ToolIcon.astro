---
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
  /** Texto del monograma cuando no hay logo (se muestra en un recuadro neutro). */
  monogram?: string;
  /** Color oficial de la marca (logos monocromos). */
  color?: string;
}

const { icon, monogram, color } = Astro.props;
---

{icon ? (
  <Icon
    name={icon}
    class="size-[1.375rem] shrink-0"
    style={color ? `color:${color}` : undefined}
    aria-hidden="true"
  />
) : (
  <span
    aria-hidden="true"
    class="inline-flex h-[1.375rem] min-w-[1.375rem] shrink-0 items-center justify-center rounded-[5px] border border-soft px-1 text-[0.625rem] leading-none font-bold tracking-tight text-soft"
  >
    {monogram}
  </span>
)}
