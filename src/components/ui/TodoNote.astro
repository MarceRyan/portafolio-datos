---
// Marcador visible para datos que faltan. Se busca con: grep -rn "TODO(marcelo)" src
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p
  class:list={[
    'rounded-ui border border-dashed border-decide px-3 py-2 text-sm text-ink',
    className,
  ]}
>
  <slot />
</p>
