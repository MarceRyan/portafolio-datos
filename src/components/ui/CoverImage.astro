---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  /** Slug del caso: busca src/assets/images/casos/<slug>.(png|jpg|jpeg|webp|avif). */
  slug: string;
  /** Portada declarada en el frontmatter del caso; tiene prioridad sobre la convención por slug. */
  cover?: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  slug,
  cover: declared,
  alt,
  sizes = '(min-width: 1024px) 40rem, 100vw',
  class: className,
  loading = 'lazy',
} = Astro.props;

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/casos/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const match = Object.entries(covers).find(([path]) => {
  const file = path.split('/').pop() ?? '';
  return file.replace(/\.[^.]+$/, '') === slug;
});
const cover = declared ?? match?.[1].default;
---

{cover ? (
  <Image
    src={cover}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes={sizes}
    loading={loading}
    class:list={['size-full object-cover', className]}
  />
) : (
  <div
    class:list={[
      'flex size-full flex-col items-center justify-center gap-2 bg-raw-3 p-4 text-center text-soft',
      className,
    ]}
  >
    <Icon name="ph:image-fill" class="size-8" aria-hidden="true" />
    <p
      data-todo={`TODO(marcelo): captura en src/assets/images/casos/${slug}.png`}
      class="max-w-[28ch] text-sm text-ink"
    >
      Captura del tablero
    </p>
  </div>
)}
