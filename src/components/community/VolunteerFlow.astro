---
// Opción C: una sesión como flujo de tres pasos (igual que "Cómo trabajo") y los temas como etiquetas.
import { Icon } from 'astro-icon/components';
import { community } from '../../data/community';

const stepColor = ['bg-clean', 'bg-clean', 'bg-decide'];
---

<div class="grid gap-14">
  <div class="max-w-[48rem]">
    <p class="font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
      {community.role} en {community.organization} ({community.short}).
    </p>
    <p class="mt-3 text-lg text-body">Desde {community.since}, en talleres sobre datos e IA.</p>
  </div>

  <div>
    <p class="text-sm font-semibold text-soft">Así acompaño cada sesión</p>
    <ol class="flow relative mt-6 grid gap-8 md:grid-cols-3 md:gap-6" data-reveal>
      <span
        aria-hidden="true"
        class="flow-line absolute top-6 right-[16.66%] left-[16.66%] hidden h-0.5 bg-clean md:block"
      ></span>
      {community.tasks.map((task, index) => (
        <li class="step relative flex flex-col items-center text-center" style={`--i:${index}`}>
          <span
            aria-hidden="true"
            class:list={[
              'relative z-10 flex size-12 items-center justify-center rounded-full text-bg ring-8 ring-bg',
              stepColor[index],
            ]}
          >
            <Icon name={task.icon} class="size-6" />
          </span>
          <span class="mt-2 text-xs font-semibold text-soft tabular-nums">Paso {index + 1}</span>
          <span class="mt-1 max-w-[22ch] font-display text-lg leading-snug font-bold text-ink">
            {task.text}
          </span>
        </li>
      ))}
    </ol>
  </div>

  <div>
    <p class="text-sm font-semibold text-soft">Talleres que moderé</p>
    <ul class="mt-4 flex flex-wrap gap-3">
      {community.workshops.map((workshop) => (
        <li class="flex min-h-12 items-center gap-3 rounded-full border border-line bg-surface py-2 pr-5 pl-2 text-ink transition-colors duration-150 hover:border-clean">
          <span
            aria-hidden="true"
            class="flex size-8 items-center justify-center rounded-full bg-bg text-clean"
          >
            <Icon name={workshop.icon} class="size-4" />
          </span>
          {workshop.title}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .flow[data-armed] .flow-line {
    transform: scaleX(0);
    transform-origin: left;
  }
  .flow[data-armed] .step {
    opacity: 0;
    transform: translateY(8px);
  }
  .flow[data-in] .flow-line {
    transform: scaleX(1);
    transition: transform 900ms cubic-bezier(0.77, 0, 0.175, 1);
  }
  .flow[data-in] .step {
    transition:
      opacity 400ms cubic-bezier(0.23, 1, 0.32, 1) calc(150ms + var(--i) * 260ms),
      transform 400ms cubic-bezier(0.23, 1, 0.32, 1) calc(150ms + var(--i) * 260ms);
  }
</style>
