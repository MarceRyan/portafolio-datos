---
// Opción B: ficha del rol a la izquierda y mosaico de talleres a la derecha.
import { Icon } from 'astro-icon/components';
import { community } from '../../data/community';

// Mosaico de 6 columnas: el primer taller más grande, luego 2 + 2 + 2 + ... (4+2 / 2+2+2).
const spans = ['sm:col-span-4', 'sm:col-span-2', 'sm:col-span-2', 'sm:col-span-2', 'sm:col-span-2'];
---

<div class="grid gap-10 lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-12">
  <div class="flex flex-col gap-6 rounded-ui border border-line bg-surface p-6 lg:self-start">
    <div class="flex items-center gap-4">
      <span
        aria-hidden="true"
        class="flex size-16 shrink-0 items-center justify-center rounded-full bg-ink font-display text-lg font-black text-bg"
      >
        {community.short}
      </span>
      <div>
        <p class="font-display text-xl leading-tight font-extrabold text-ink">{community.role}</p>
        <p class="text-sm text-body">{community.organization}</p>
      </div>
    </div>
    <p class="flex items-center gap-2 text-sm font-semibold text-ink">
      <span aria-hidden="true" class="badge-dot relative size-2.5 rounded-full bg-clean"></span>
      Activo desde {community.since}
    </p>
    <ul class="flex flex-col gap-4 border-t border-line pt-6">
      {community.tasks.map((task) => (
        <li class="flex items-start gap-3 text-body">
          <Icon name={task.icon} aria-hidden="true" class="mt-0.5 size-5 shrink-0 text-clean" />
          {task.text}
        </li>
      ))}
    </ul>
  </div>

  <div>
    <p class="text-sm font-semibold text-soft">Talleres que moderé</p>
    <ul class="mosaic mt-4 grid gap-4 sm:grid-cols-6" data-reveal>
      {community.workshops.map((workshop, index) => (
        <li
          class:list={[
            'tile group flex flex-col justify-between gap-6 rounded-ui border border-line bg-surface p-5 transition-[border-color,transform] duration-200 ease-out hover:-translate-y-0.5 hover:border-clean',
            spans[index],
            index === 0 && 'sm:min-h-44',
          ]}
          style={`--i:${index}`}
        >
          <span
            aria-hidden="true"
            class:list={[
              'flex shrink-0 items-center justify-center rounded-ui',
              index === 0 ? 'size-12 bg-clean text-bg' : 'size-10 bg-bg text-clean',
            ]}
          >
            <Icon name={workshop.icon} class={index === 0 ? 'size-6' : 'size-5'} />
          </span>
          <span>
            <span class="block text-xs font-semibold text-soft tabular-nums">
              Taller {String(index + 1).padStart(2, '0')}
            </span>
            <span
              class:list={[
                'mt-1 block font-display leading-snug font-bold text-ink',
                index === 0 ? 'text-2xl' : 'text-lg',
              ]}
            >
              {workshop.title}
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .badge-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: var(--clean);
    animation: badge-pulse 2.4s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }
  @keyframes badge-pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .mosaic[data-armed] .tile {
    opacity: 0;
    transform: translateY(12px) scale(0.98);
  }
  .mosaic[data-in] .tile {
    transition:
      opacity 420ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 100ms),
      transform 420ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 100ms),
      border-color 200ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-dot::after {
      animation: none;
    }
  }
</style>
