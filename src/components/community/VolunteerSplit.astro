---
// Opción E: dos columnas compactas. Rol y tareas a la izquierda; lista numerada corta a la derecha.
import { Icon } from 'astro-icon/components';
import { community } from '../../data/community';
---

<div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:gap-12">
  <div>
    <p class="text-sm font-semibold text-soft">Desde {community.since}</p>
    <p class="mt-1 font-display text-2xl leading-tight font-extrabold text-ink">
      {community.role} en {community.organization} ({community.short})
    </p>
    <ul class="mt-4 flex flex-col gap-2 text-body">
      {community.tasks.map((task) => (
        <li class="flex items-center gap-3">
          <Icon name={task.icon} aria-hidden="true" class="size-5 shrink-0 text-clean" />
          {task.text}
        </li>
      ))}
    </ul>
  </div>

  <ol class="split-list divide-y divide-line border-y border-line" data-reveal>
    {community.workshops.map((workshop, index) => (
      <li class="split-row group flex min-h-11 items-center gap-4 py-2.5" style={`--i:${index}`}>
        <span class="w-6 shrink-0 font-display text-sm font-black text-soft tabular-nums transition-colors duration-150 group-hover:text-clean">
          {String(index + 1).padStart(2, '0')}
        </span>
        <span class="flex-1 font-medium text-ink">{workshop.title}</span>
        <Icon
          name={workshop.icon}
          aria-hidden="true"
          class="size-5 shrink-0 text-soft transition-colors duration-150 group-hover:text-clean"
        />
      </li>
    ))}
  </ol>
</div>

<style>
  .split-list[data-armed] .split-row {
    opacity: 0;
    transform: translateX(-8px);
  }
  .split-list[data-in] .split-row {
    transition:
      opacity 360ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 90ms),
      transform 360ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 90ms);
  }
</style>
