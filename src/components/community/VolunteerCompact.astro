---
// Opción D: un solo panel compacto. Rol y estado arriba, tareas en una línea, talleres como etiquetas.
import { Icon } from 'astro-icon/components';
import { community } from '../../data/community';
---

<div class="rounded-ui border border-line bg-surface p-5 sm:p-6">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <div class="flex items-center gap-4">
      <span
        aria-hidden="true"
        class="flex size-12 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-black text-bg"
      >
        {community.short}
      </span>
      <div>
        <p class="font-display text-xl leading-tight font-extrabold text-ink">{community.role}</p>
        <p class="text-sm text-body">{community.organization}</p>
      </div>
    </div>
    <p class="flex items-center gap-2 text-sm font-semibold text-ink">
      <span aria-hidden="true" class="compact-dot relative size-2.5 rounded-full bg-clean"></span>
      Activo desde {community.since}
    </p>
  </div>

  <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-body">
    {community.tasks.map((task) => (
      <li class="flex items-center gap-2">
        <Icon name={task.icon} aria-hidden="true" class="size-4 shrink-0 text-clean" />
        {task.text}
      </li>
    ))}
  </ul>

  <div class="mt-5 border-t border-line pt-5">
    <p class="text-sm font-semibold text-soft">Talleres que moderé</p>
    <ul class="compact-chips mt-3 flex flex-wrap gap-2" data-reveal>
      {community.workshops.map((workshop, index) => (
        <li
          class="chip flex min-h-10 items-center gap-2 rounded-full border border-line bg-bg py-1.5 pr-4 pl-2 text-sm text-ink transition-colors duration-150 hover:border-clean"
          style={`--i:${index}`}
        >
          <Icon name={workshop.icon} aria-hidden="true" class="size-4 shrink-0 text-clean" />
          {workshop.title}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .compact-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background-color: var(--clean);
    animation: compact-pulse 2.4s cubic-bezier(0.23, 1, 0.32, 1) infinite;
  }
  @keyframes compact-pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .compact-chips[data-armed] .chip {
    opacity: 0;
    transform: translateY(6px);
  }
  .compact-chips[data-in] .chip {
    transition:
      opacity 360ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 80ms),
      transform 360ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i) * 80ms),
      border-color 150ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .compact-dot::after {
      animation: none;
    }
  }
</style>
