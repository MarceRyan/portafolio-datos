---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import ToolChips from '../ui/ToolChips.astro';
import ExperienceList from '../experience/ExperienceList.astro';
import { site } from '../../data/site';
import { resolveTools } from '../../data/tool-refs';

// Tecnologías con las que trabajo a diario (nombres de src/data/tool-refs.ts).
const tech = resolveTools([
  'SQL',
  'SQL Server',
  'Python',
  'Power BI',
  'SSIS',
  'Excel',
  'Google Sheets',
  'Apps Script',
  'Power Automate',
  'Selenium',
  'RStudio',
  'Claude',
]);
---

<section
  id="sobre-mi"
  aria-labelledby="sobre-mi-title"
  class="border-y border-line bg-surface py-20 sm:py-24"
>
  <div class="wrap">
    <h2 id="sobre-mi-title" class="text-3xl font-extrabold sm:text-4xl">
      Sobre mí
    </h2>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
      <div class="max-w-[62ch]">
        <p class="font-display text-2xl leading-snug font-bold text-ink sm:text-3xl">
          De ordenar procesos a ordenar datos.
        </p>
        <div class="mt-6 flex flex-col gap-4 text-lg leading-relaxed text-body">
          <p>
            ¡Hola! Soy Marcelo, analista de datos con formación en Ingeniería de Sistemas y
            Computación. Antes de dedicarme a los datos trabajé en logística, administración y
            soporte técnico. Di el paso al análisis gracias a la constancia y a las ganas de
            aprender, y hoy los datos son mi día a día.
          </p>
          <p>
            Con más de dos años de experiencia, mi trabajo abarca el camino completo del dato: creo
            programas que recolectan la información, la limpio, la ordeno en una base y la convierto
            en decisiones a través del storytelling con datos. También automatizo tareas repetitivas
            para que el equipo dedique su tiempo a analizar.
          </p>
          <p>
            Sigo aprendiendo y explorando nuevas tecnologías, con especial interés en la
            inteligencia artificial. Me certifiqué como Associate Data Engineer y Associate Data
            Analyst, y modero talleres de datos e inteligencia artificial en Data Science Research
            Perú.
          </p>
        </div>

        <h3 class="mt-10 text-lg font-bold">Algunas de las tecnologías con las que trabajo</h3>
        <ToolChips tools={tech} class="mt-4" />
      </div>

      <div class="lg:pt-2">
        <Button href={site.cvPath} variant="secondary" download>
          <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
          Descargar CV
        </Button>
      </div>
    </div>

    <div class="mt-16">
      <ExperienceList />
    </div>
  </div>
</section>
