---
// Sobre mí en tres capítulos, cada uno con el color de un estado del dato:
// de dónde vengo (crudo), qué hago hoy (limpio) y hacia dónde voy (decisión).
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import ToolIcon from '../ui/ToolIcon.astro';
import ExperienceList from '../experience/ExperienceList.astro';
import { about, highlights } from '../../data/about';
import { site } from '../../data/site';
import { resolveTools } from '../../data/tool-refs';

// Clases por capítulo. `raw` no sirve para texto: ahí el resaltado va en tinta.
const tones = [
  { bar: 'bg-raw-2', badge: 'bg-raw-3 text-ink', icon: 'text-raw-2', strong: 'text-ink' },
  { bar: 'bg-clean', badge: 'bg-clean text-bg', icon: 'text-clean', strong: 'text-clean' },
  { bar: 'bg-decide', badge: 'bg-decide text-bg', icon: 'text-decide', strong: 'text-decide' },
];
---

<section
  id="sobre-mi"
  aria-labelledby="sobre-mi-title"
  class="border-y border-line bg-surface py-20 sm:py-24"
>
  <div class="wrap">
    <h2 id="sobre-mi-title" class="text-3xl font-extrabold sm:text-4xl">
      Sobre mí
    </h2>

    <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
      <p class="max-w-[22ch] border-l-4 border-clean pl-5 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
        {highlights(about.headline).map((part) =>
          part.strong ? <span class="text-clean">{part.text}</span> : part.text,
        )}
      </p>
      <Button href={site.cvPath} variant="secondary" download>
        <Icon name="ph:download-simple" class="size-5" aria-hidden="true" />
        Descargar CV
      </Button>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {about.chapters.map((chapter, index) => {
        const tone = tones[index] ?? tones[0]!;
        return (
          <li class="relative flex flex-col overflow-hidden rounded-ui border border-line bg-bg p-6 pt-7">
            <span aria-hidden="true" class:list={['absolute inset-x-0 top-0 h-1', tone.bar]} />
            <div class="flex items-center justify-between gap-3">
              <span
                class:list={[
                  'inline-flex h-7 min-w-9 items-center justify-center rounded-full px-2.5 font-display text-sm font-black tabular-nums',
                  tone.badge,
                ]}
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <Icon name={chapter.icon} aria-hidden="true" class:list={['size-6', tone.icon]} />
            </div>
            <h3 class="mt-4 text-xl font-extrabold">{chapter.title}</h3>
            <p class="mt-3 leading-relaxed text-body">
              {highlights(chapter.text).map((part) =>
                part.strong ? (
                  <strong class:list={['font-semibold', tone.strong]}>{part.text}</strong>
                ) : (
                  part.text
                ),
              )}
            </p>
          </li>
        );
      })}
    </ol>

    <div class="mt-12">
      <h3 class="text-lg font-bold">Tecnologías con las que trabajo</h3>
      <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6">
        {resolveTools(about.tech).map((tool) => (
          <li class="group flex flex-col items-center gap-2 rounded-ui border border-line bg-bg px-2 py-4 text-center text-sm font-medium text-ink transition-[border-color,transform] duration-200 ease-out hover:-translate-y-0.5 hover:border-clean">
            <span class="transition-colors duration-200 group-hover:text-clean [&_svg]:size-7">
              <ToolIcon icon={tool.icon} monogram={tool.monogram} />
            </span>
            {tool.name}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-16">
      <ExperienceList />
    </div>
  </div>
</section>
