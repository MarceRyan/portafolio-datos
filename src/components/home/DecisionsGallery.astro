---
import CoverImage from '../ui/CoverImage.astro';
import { getCasos } from '../../data/casos';
import { parseImpact } from '../../data/impact';

const featured = (await getCasos()).filter((caso) => caso.data.featured);
const imageLink = 'block aspect-[16/9] overflow-hidden rounded-ui border border-line';
const zoom =
  'transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:scale-[1.02]';
---

<section id="decisiones" aria-labelledby="decisiones-title" class="wrap py-20 sm:py-28">
  <h2 id="decisiones-title" class="text-3xl font-extrabold sm:text-4xl">
    Decisiones que ayudé a tomar
  </h2>

  {/* Tres cuadros del mismo tamaño; el caso con cifra la muestra bajo su título. */}
  <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-3">
    {featured.map((caso, index) => {
      const impact = caso.data.impact?.[0];
      const target = impact ? parseImpact(impact.value) : null;
      return (
        <article class="group">
          <a
            href={`/casos/${caso.data.slug}`}
            tabindex="-1"
            aria-hidden="true"
            transition:name={`cover-${caso.data.slug}`}
            class={imageLink}
          >
            <CoverImage
              slug={caso.data.slug}
              cover={caso.data.cover}
              alt={`Captura del tablero: ${caso.data.title}`}
              sizes="(min-width: 768px) 26rem, 100vw"
              loading={index === 0 ? 'eager' : 'lazy'}
              class={zoom}
            />
          </a>
          <h3 class="mt-4 max-w-[26ch] text-xl font-bold">
            <a href={`/casos/${caso.data.slug}`} class="underline-offset-4 hover:underline">
              {caso.data.title}
            </a>
          </h3>
          {impact && (
            <div class="mt-4">
              <p
                aria-hidden="true"
                data-count-to={target?.value}
                data-decimals={target?.decimals}
                data-suffix={target?.suffix}
                class="font-display text-4xl leading-none font-black text-decide"
              >
                {impact.value}
              </p>
              <p class="sr-only">{impact.value}</p>
              <p class="mt-2 max-w-[28ch] text-sm text-body">{impact.label}</p>
            </div>
          )}
        </article>
      );
    })}
  </div>

  <p class="mt-12 text-sm text-soft">
    Los datos de estos casos fueron anonimizados por confidencialidad institucional.
  </p>
</section>

<script>
  import '../../scripts/count-up';
</script>
