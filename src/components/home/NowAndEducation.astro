---
import { certifications } from '../../data/certifications';
import { now, nowUpdated } from '../../data/now';

const updatedLabel = new Intl.DateTimeFormat('es-PE', { month: 'long', year: 'numeric' }).format(
  new Date(`${nowUpdated}T12:00:00`),
);
---

<section id="ahora-mismo" class="border-y border-line bg-surface py-20 sm:py-24">
  <div class="wrap grid gap-16 md:grid-cols-2 md:gap-20">
    <div role="group" aria-labelledby="ahora-title">
      <h2 id="ahora-title" class="text-3xl font-extrabold">
        Ahora mismo
      </h2>
      <p class="mt-2 text-sm text-soft">
        Actualizado en <time datetime={nowUpdated}>{updatedLabel}</time>
      </p>
      <ul class="mt-8 flex flex-col gap-5">
        {now.map((item) => (
          <li class="max-w-[48ch] text-lg text-body">{item}</li>
        ))}
      </ul>
    </div>

    <div role="group" aria-labelledby="formacion-title">
      <h2 id="formacion-title" class="text-3xl font-extrabold">
        Formación
      </h2>
      <ul class="mt-8 flex flex-col gap-6">
        {certifications.map((item) => (
          <li>
            <p class="text-lg font-semibold text-ink">{item.title}</p>
            <p class="text-body">
              {item.institution}, <span class="tabular-nums">{item.year}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
