---
import ExperienceList from '../experience/ExperienceList.astro';
---

<section
  id="trayectoria"
  aria-labelledby="trayectoria-title"
  class="border-y border-line bg-surface py-20 sm:py-24"
>
  <div class="wrap">
    <h2 id="trayectoria-title" class="text-3xl font-extrabold sm:text-4xl">
      Trayectoria
    </h2>
    <p class="mt-4 max-w-[62ch] text-lg text-body">
      Del control de inventario a los tableros de las gerencias. Elige un puesto para ver qué hice
      en cada uno.
    </p>
    <div class="mt-12">
      <ExperienceList />
    </div>
  </div>
</section>
