---
import ToolIcon from '../ui/ToolIcon.astro';
import { stages, stageStates, tools } from '../../data/tools';

const legend = [
  { state: 'raw', label: 'Dato crudo', swatch: 'bg-raw' },
  { state: 'clean', label: 'Dato limpio', swatch: 'bg-clean' },
  { state: 'decide', label: 'Decisión', swatch: 'bg-decide' },
] as const;

const barByState = { raw: 'bg-raw', clean: 'bg-clean', decide: 'bg-decide' } as const;

const columns = stages.map((stage) => ({
  ...stage,
  tools: tools
    .filter((tool) => tool.stage === stage.id)
    .map((tool, index) => ({ ...tool, id: `tip-${stage.id}-${index}` })),
}));
---

<section
  id="como-trabajo"
  aria-labelledby="motor-title"
  class="border-y border-line bg-surface py-20 sm:py-24"
>
  <div class="wrap">
    <h2 id="motor-title" class="text-3xl font-extrabold sm:text-4xl">
      Cómo trabajo
    </h2>

    <p class="mt-4 max-w-[62ch] text-lg text-body">
      Los datos suelen estar desordenados: repartidos en hojas, formularios, correos y páginas web.
      Creo programas que los recolectan solos, los limpio, los reúno en un solo lugar y los
      convierto en tableros claros, para que quien decide lo haga con evidencia.
    </p>

    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-body" aria-label="Leyenda">
      {legend.map((item) => (
        <li class="flex items-center gap-2">
          <span aria-hidden="true" class:list={['size-3 rounded-full', item.swatch]} />
          {item.label}
        </li>
      ))}
    </ul>
    <p class="mt-3 hidden text-sm text-soft md:block">
      Pasa el cursor sobre una herramienta para ver qué hace en cada paso.
    </p>

    <ol class="mt-12 grid gap-12 md:grid-cols-5 md:grid-rows-[auto_13rem_auto] md:gap-0">
      {columns.map((stage, index) => (
        <li class="md:row-span-3 md:grid md:grid-rows-subgrid">
          <div class="md:row-start-1 md:pr-4">
            <span
              aria-hidden="true"
              class:list={['block h-1 w-10 rounded-full', barByState[stage.state]]}
            />
            <h3 class="mt-3 flex items-baseline gap-2 text-xl font-bold">
              <span class="tabular-nums text-soft">{stage.number}</span>
              {stage.name}
              <span class="sr-only">({stageStates[stage.state]})</span>
            </h3>
            <p class="mt-2 text-sm leading-snug text-soft">{stage.description}</p>
          </div>

          {index === 0 && (
            <div
              aria-hidden="true"
              class="pointer-events-none relative hidden md:col-start-1 md:row-start-2 md:block"
              style="width: 500%"
            >
              <canvas data-engine-canvas class="absolute inset-0 size-full" />
            </div>
          )}

          <ul class="mt-4 flex flex-col gap-1 md:row-start-3 md:mt-0 md:pr-4">
            {stage.tools.map((tool) => (
              <li class="relative">
                <button
                  type="button"
                  data-tool
                  aria-describedby={tool.id}
                  aria-expanded="false"
                  class="flex min-h-11 w-full items-center gap-3 rounded-ui px-2 py-1.5 text-left text-[0.95rem] font-medium text-ink transition-colors duration-150 hover:bg-bg"
                >
                  <ToolIcon icon={tool.icon} monogram={tool.monogram} />
                  {tool.name}
                </button>
                <span id={tool.id} role="tooltip" class="tool-tip">
                  {tool.context}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Escritorio: tooltip sobre el botón, origen en la esquina inferior izquierda. */
  .tool-tip {
    position: absolute;
    bottom: calc(100% + 0.25rem);
    left: 0;
    z-index: 30;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2.5rem));
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background-color: var(--surface);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.4;
    pointer-events: none;
    opacity: 0;
    transform: translateX(var(--shift, 0px)) scale(0.97);
    transform-origin: 1rem 100%;
    transition:
      opacity 125ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 125ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .tool-tip[data-open] {
    opacity: 1;
    transform: translateX(var(--shift, 0px)) scale(1);
  }
  /* Tras el primer tooltip, los siguientes aparecen sin animación. */
  .tool-tip[data-instant] {
    transition-duration: 0ms;
  }

  /* Móvil: no hay hover, así que el texto se muestra siempre bajo la herramienta. */
  @media (max-width: 767.98px) {
    .tool-tip {
      display: block;
      position: static;
      width: auto;
      max-width: none;
      margin-left: 2.75rem;
      padding: 0 0 0.5rem;
      border: 0;
      background: transparent;
      color: var(--soft);
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import '../../scripts/tool-tooltips';
  import '../../scripts/decision-engine';
</script>
