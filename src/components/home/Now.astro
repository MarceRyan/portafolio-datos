---
import { Icon } from 'astro-icon/components';
import { now, nowUpdated } from '../../data/now';

const updatedLabel = new Intl.DateTimeFormat('es-PE', { month: 'long', year: 'numeric' }).format(
  new Date(`${nowUpdated}T12:00:00`),
);
---

<section id="ahora-mismo" aria-labelledby="ahora-title" class="wrap py-20 sm:py-28">
  <h2 id="ahora-title" class="text-3xl font-extrabold sm:text-4xl">
    Ahora mismo
  </h2>
  <p class="mt-2 text-sm text-soft">
    Actualizado en <time datetime={nowUpdated}>{updatedLabel}</time>
  </p>

  <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
    {now.map((item) => (
      <li class="flex flex-col gap-4">
        <span
          aria-hidden="true"
          class="flex size-12 items-center justify-center rounded-ui bg-ink text-bg"
        >
          <Icon name={item.icon} class="size-6" />
        </span>
        <p class="max-w-[34ch] text-lg text-body">{item.text}</p>
      </li>
    ))}
  </ul>
</section>
