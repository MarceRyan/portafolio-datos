---
// Inicio: saludo, nombre, el puesto que se escribe y se borra rotando entre los que busca,
// una línea de presentación, dos botones y la foto en un anillo de datos.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from '../ui/Placeholder.astro';
import { buttonClasses } from '../ui/button-classes';

// Si existe src/assets/photo/perfil.(jpg|png|webp|avif) se usa; si no, silueta + TODO.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/photo/perfil.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const photo = Object.values(photos)[0]?.default;

const roles = ['Analista de Datos', 'Analista BI', 'Ingeniero de Datos'];
---

<section class="hero-backdrop">
  <div class="wrap grid items-center gap-12 py-12 lg:grid-cols-[1.3fr_1fr] lg:py-16">
    <div>
      <p class="rise text-lg font-semibold text-soft" style="--d:0">
        Hola, soy
      </p>
      <h1 class="mt-2 text-[clamp(2.5rem,6.5vw,4.25rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">
        Marcelo Morales Rimac
      </h1>
      <p class="mt-3 font-display text-[clamp(1.75rem,4.5vw,2.75rem)] leading-tight font-extrabold">
        <span class="sr-only">Analista de Datos, Analista BI e Ingeniero de Datos</span>
        <span aria-hidden="true" class="typing text-clean" data-typing={JSON.stringify(roles)}>
          {roles[0]}
        </span>
      </p>
      <p class="rise mt-5 max-w-[48ch] text-lg text-body" style="--d:1">
        Convierto datos desordenados en decisiones claras: los recolecto, los limpio y los convierto
        en tableros que se entienden de un vistazo.
      </p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--d:2">
        <a href="/proyectos" class={buttonClasses('primary')}>
          Ver proyectos
        </a>
        <a href="/#sobre-mi" class={buttonClasses('secondary')}>
          Conóceme
        </a>
      </div>
    </div>

    <div class="flex justify-center">
      <div class="relative">
        <span aria-hidden="true" class="photo-ring absolute -inset-3 rounded-full"></span>
        {photo ? (
          <Image
            src={photo}
            alt="Retrato profesional de Marcelo Morales Rimac"
            widths={[320, 480, 640]}
            sizes="(min-width: 640px) 20rem, 16rem"
            loading="eager"
            fetchpriority="high"
            class="relative size-64 rounded-full object-cover object-top sm:size-80"
          />
        ) : (
          <div class="relative flex size-64 items-center justify-center rounded-full bg-raw-3 sm:size-80">
            <Placeholder
              class="bg-bg text-center"
              todo="TODO(marcelo): foto profesional vertical 4:5 en src/assets/photo/perfil.jpg"
            >
              Foto profesional
            </Placeholder>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Cursor de escritura al final del puesto. */
  .typing::after {
    content: '|';
    margin-left: 0.05em;
    font-weight: 400;
    animation: caret-blink 1s steps(1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .typing::after {
      animation: none;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  /* Anillo de datos alrededor de la foto: limpio (cian), decisión (ámbar) y el resto en línea. */
  .photo-ring {
    background: conic-gradient(var(--clean) 0 62%, var(--decide) 62% 78%, var(--line) 78% 100%);
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), black calc(100% - 3px));
  }
</style>

<script>
  import '../../scripts/typing';
</script>
