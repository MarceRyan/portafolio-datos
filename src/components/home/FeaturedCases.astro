---
import Button from '../ui/Button.astro';
import TodoNote from '../ui/TodoNote.astro';
import { casosDestacados } from '../../data/casos-destacados';

const [main, ...rest] = casosDestacados;
const label = 'text-sm font-semibold text-soft';
---

<section id="casos-destacados" aria-labelledby="casos-title" class="wrap py-20 sm:py-28">
  <h2 id="casos-title" class="text-3xl font-extrabold sm:text-4xl">
    Decisiones que ayudé a tomar
  </h2>

  {main && (
    <article class="mt-12 rounded-ui border border-line bg-surface p-6 sm:p-10">
      <h3 class="max-w-[28ch] text-2xl font-extrabold sm:text-3xl">
        <a href={`/casos/${main.slug}`} class="underline-offset-4 hover:underline">
          {main.title}
        </a>
      </h3>
      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>La pregunta</h4>
          <p class="mt-3 font-display text-xl leading-snug font-bold text-ink sm:text-2xl">
            {main.question}
          </p>
        </div>
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>Lo que construí</h4>
          <p class="mt-3 text-body">{main.built}</p>
        </div>
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>El resultado</h4>
          {main.result ? (
            <>
              <p
                aria-hidden="true"
                data-count-to={main.result.value}
                data-decimals={main.result.decimals}
                data-suffix={main.result.suffix}
                class="mt-3 font-display text-6xl leading-none font-black text-decide sm:text-7xl"
              >
                {`${main.result.value.toFixed(main.result.decimals)}${main.result.suffix}`}
              </p>
              <p class="sr-only">
                {main.result.value.toFixed(main.result.decimals)}
                {main.result.suffix}
              </p>
              <p class="mt-3 text-body">{main.result.label}</p>
            </>
          ) : (
            <TodoNote class="mt-3">TODO(marcelo): resultado medible de este caso.</TodoNote>
          )}
        </div>
      </div>
    </article>
  )}

  {rest.map((caso) => (
    <article class="mt-12 border-t border-line pt-10">
      <h3 class="max-w-[34ch] text-xl font-bold sm:text-2xl">
        <a href={`/casos/${caso.slug}`} class="underline-offset-4 hover:underline">
          {caso.title}
        </a>
      </h3>
      <div class="mt-6 grid gap-6 md:grid-cols-3 md:gap-12">
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>La pregunta</h4>
          <p class="mt-2 font-display text-lg leading-snug font-bold text-ink">{caso.question}</p>
        </div>
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>Lo que construí</h4>
          <p class="mt-2 text-body">{caso.built}</p>
        </div>
        <div>
          <h4 class:list={[label, 'font-sans tracking-normal']}>El resultado</h4>
          <TodoNote class="mt-2">TODO(marcelo): resultado medible de este caso.</TodoNote>
        </div>
      </div>
    </article>
  ))}

  <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-line pt-8">
    <Button href="/casos" variant="secondary">
      Ver casos
    </Button>
    <p class="text-sm text-soft">
      Los datos de estos casos fueron anonimizados por confidencialidad institucional.
    </p>
  </div>
</section>

<script>
  import '../../scripts/count-up';
</script>
