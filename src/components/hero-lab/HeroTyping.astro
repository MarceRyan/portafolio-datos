---
// Opción B: el rol se escribe y se borra rotando entre los puestos que busca; foto en círculo y cifras reales.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import photo from '../../assets/photo/perfil.jpg';
import { buttonClasses } from '../ui/button-classes';
import { certifications } from '../../data/certifications';

const roles = ['Analista de Datos', 'Analista BI', 'Ingeniero de Datos'];
const projects = (await getCollection('casos')).length;
const certificates = certifications.filter((item) => item.certificate).length;
const stats = [
  { value: '+2', label: 'años de experiencia' },
  { value: String(projects), label: 'proyectos' },
  { value: String(certificates), label: 'certificaciones' },
];
---

<section class="hero-backdrop">
  <div class="wrap grid items-center gap-12 py-14 lg:grid-cols-[1.3fr_1fr] lg:py-16">
    <div>
      <p class="text-lg font-semibold text-soft">Hola, soy</p>
      <h1 class="mt-2 text-[clamp(2.5rem,6.5vw,4.25rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">
        Marcelo Morales Rimac
      </h1>
      <p class="mt-3 font-display text-[clamp(1.75rem,4.5vw,2.75rem)] leading-tight font-extrabold">
        <span class="sr-only">Analista de Datos, Analista BI e Ingeniero de Datos</span>
        <span aria-hidden="true" class="text-clean" data-typing={JSON.stringify(roles)}>
          {roles[0]}
        </span>
        <span aria-hidden="true" class="typing-caret text-clean">
          |
        </span>
      </p>
      <p class="mt-5 max-w-[48ch] text-lg text-body">
        Convierto datos desordenados en decisiones claras: los recolecto, los limpio y los convierto
        en tableros que se entienden de un vistazo.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/proyectos" class={buttonClasses('primary')}>
          Ver proyectos
        </a>
        <a href="/#sobre-mi" class={buttonClasses('secondary')}>
          Conóceme
        </a>
      </div>
      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-6">
        {stats.map((stat) => (
          <div>
            <dt class="sr-only">{stat.label}</dt>
            <dd class="font-display text-4xl leading-none font-black text-decide tabular-nums">
              {stat.value}
            </dd>
            <p aria-hidden="true" class="mt-1 text-sm text-body">
              {stat.label}
            </p>
          </div>
        ))}
      </dl>
    </div>

    <div class="flex justify-center">
      <div class="relative">
        <span aria-hidden="true" class="typing-ring absolute -inset-3 rounded-full"></span>
        <Image
          src={photo}
          alt="Retrato profesional de Marcelo Morales Rimac"
          widths={[320, 480, 640]}
          sizes="20rem"
          loading="eager"
          class="relative size-64 rounded-full object-cover object-top sm:size-80"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .typing-caret {
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  /* Anillo de datos: arco cian y ámbar alrededor de la foto. */
  .typing-ring {
    background: conic-gradient(var(--clean) 0 62%, var(--decide) 62% 78%, var(--line) 78% 100%);
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), black calc(100% - 3px));
  }
</style>

<script>
  // Escribe y borra cada rol en bucle. Sin JavaScript queda el primero, fijo.
  const PAUSE = 1600;
  document.querySelectorAll<HTMLElement>('[data-typing]').forEach((el) => {
    const words = JSON.parse(el.dataset.typing ?? '[]') as string[];
    let index = 0;
    let length = words[0]?.length ?? 0;
    let deleting = true;

    const tick = (): void => {
      const word = words[index] ?? '';
      length += deleting ? -1 : 1;
      if (deleting && length < 0) {
        deleting = false;
        index = (index + 1) % words.length;
        length = 0;
      }
      el.textContent = (words[index] ?? '').slice(0, length);
      const full = !deleting && length >= (words[index] ?? word).length;
      if (full) deleting = true;
      setTimeout(tick, full ? PAUSE : deleting ? 45 : 85);
    };
    setTimeout(tick, PAUSE);
  });
</script>
