---
// Opción A: saludo, nombre, rol en color, una línea, dos botones y la foto fundida con el fondo.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import photo from '../../assets/photo/perfil.jpg';
import { buttonClasses } from '../ui/button-classes';
import { site } from '../../data/site';
import { socials } from '../../data/socials';
---

<section class="hero-backdrop">
  <div class="wrap grid items-center gap-10 py-14 lg:grid-cols-[1.15fr_1fr] lg:py-10">
    <div>
      <p class="text-lg font-semibold text-ink">Hola, soy</p>
      <h1 class="mt-2 text-[clamp(2.5rem,6.5vw,4.25rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">
        Marcelo Morales Rimac
      </h1>
      <p class="mt-1 font-display text-[clamp(2rem,5vw,3.25rem)] leading-tight font-extrabold text-clean">
        Analista de Datos
      </p>
      <p class="mt-5 max-w-[44ch] text-lg text-body">
        Más de dos años de experiencia. Convierto datos desordenados en decisiones claras. Desde{' '}
        {site.location}.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/proyectos" class={buttonClasses('secondary')}>
          Mis proyectos
        </a>
        <a href="/#sobre-mi" class={buttonClasses('secondary')}>
          Conóceme
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center">
      <div class="greeting-photo w-full max-w-[22rem]">
        <Image
          src={photo}
          alt="Retrato profesional de Marcelo Morales Rimac"
          widths={[360, 560, 720]}
          sizes="22rem"
          loading="eager"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div class="mt-2 flex w-full max-w-[26rem] items-center gap-4">
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
        <ul class="flex items-center gap-2">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex size-11 items-center justify-center rounded-ui text-soft transition-colors duration-150 hover:text-clean"
              >
                <Icon name={`ph:${social.id}-logo`} class="size-6" aria-hidden="true" />
              </a>
            </li>
          ))}
          <li>
            <a
              href={`mailto:${site.email}`}
              aria-label="Correo"
              class="flex size-11 items-center justify-center rounded-ui text-soft transition-colors duration-150 hover:text-clean"
            >
              <Icon name="ph:envelope-simple" class="size-6" aria-hidden="true" />
            </a>
          </li>
        </ul>
        <span aria-hidden="true" class="h-px flex-1 bg-line"></span>
      </div>
    </div>
  </div>
</section>

<style>
  /* La foto se funde con el fondo: se desvanece hacia abajo y hacia los lados, sin marco. */
  .greeting-photo {
    -webkit-mask-image:
      linear-gradient(to bottom, transparent, black 12%, black 55%, transparent 98%),
      linear-gradient(to right, transparent, black 18%, black 82%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to bottom, transparent, black 12%, black 55%, transparent 98%),
      linear-gradient(to right, transparent, black 18%, black 82%, transparent);
    mask-composite: intersect;
  }
</style>
