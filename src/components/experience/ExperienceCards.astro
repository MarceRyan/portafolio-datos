---
import { Icon } from 'astro-icon/components';
import RoleDetail from './RoleDetail.astro';
import { certifications } from '../../data/certifications';
import { experience, formatPeriods, startYear, type Era } from '../../data/experience';

// Ritmo de 6 columnas: el cargo actual ocupa 4x2 y el resto varía de tamaño por fila.
const spans = [
  'lg:col-span-4 lg:row-span-2',
  'lg:col-span-2',
  'lg:col-span-2',
  'lg:col-span-3',
  'lg:col-span-3',
  'lg:col-span-2',
  'lg:col-span-4',
];

const badgeByEra: Record<Era, string> = {
  raw: 'bg-raw-3 text-ink',
  clean: 'bg-clean text-bg',
  decide: 'bg-decide text-bg',
};
---

<div class="flex flex-col gap-16">
  <div>
    <h3 class="text-2xl font-extrabold">Experiencia</h3>
    <ul class="mt-10 grid gap-6 lg:grid-cols-6">
      {experience.map((role, index) => (
        <li class:list={['flex', spans[index]]}>
          <article
            class:list={[
              'relative flex w-full flex-col gap-4 overflow-hidden rounded-ui border border-line bg-surface p-6',
              index === 0 && 'sm:p-8',
            ]}
          >
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-2 right-4 font-display text-7xl leading-none font-black text-raw-3 tabular-nums select-none"
            >
              {startYear(role)}
            </span>
            <span
              aria-hidden="true"
              class:list={[
                'relative flex size-11 items-center justify-center rounded-ui',
                badgeByEra[role.era],
              ]}
            >
              <Icon name={role.icon} class="size-6" />
            </span>
            <div class="relative">
              <p class="text-sm font-semibold text-soft">{formatPeriods(role.periods)}</p>
              <h4
                class:list={[
                  'mt-1 font-display font-extrabold text-ink',
                  index === 0 ? 'text-3xl' : 'text-xl',
                ]}
              >
                {role.title}
              </h4>
              <p class="text-body">
                {role.org}, {role.place}
              </p>
            </div>
            <RoleDetail role={role} class="relative" />
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div>
    <h3 class="text-2xl font-extrabold">Formación</h3>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {certifications.map((item, index) => (
        <li class:list={['flex', index === 0 && 'lg:col-span-2']}>
          <article class="relative flex w-full flex-col gap-3 overflow-hidden rounded-ui border border-line bg-surface p-6">
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-2 right-4 font-display text-7xl leading-none font-black text-raw-3 tabular-nums select-none"
            >
              {item.year}
            </span>
            <span
              aria-hidden="true"
              class="relative flex size-11 items-center justify-center rounded-ui bg-ink text-bg"
            >
              <Icon name={item.icon} class="size-6" />
            </span>
            <div class="relative">
              <h4 class="text-lg leading-snug font-bold text-ink">{item.title}</h4>
              <p class="mt-1 text-body">{item.institution}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</div>
