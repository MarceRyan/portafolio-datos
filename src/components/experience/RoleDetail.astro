---
import ToolChips from '../ui/ToolChips.astro';
import type { Role } from '../../data/experience';

interface Props {
  role: Role;
  class?: string;
}

const { role, class: className } = Astro.props;
const hasContent = role.tools || role.groups || role.highlights || role.metrics;
---

{hasContent && (
  <div class:list={['flex flex-col gap-6', className]}>
    {role.metrics && (
      <dl class="flex flex-wrap gap-x-10 gap-y-4">
        {role.metrics.map((metric) => (
          <div>
            <dt class="sr-only">{metric.label}</dt>
            <dd class="font-display text-5xl leading-none font-black text-decide">
              {metric.value}
            </dd>
            <p aria-hidden="true" class="mt-1 text-sm text-body">
              {metric.label}
            </p>
          </div>
        ))}
      </dl>
    )}

    {role.highlights && (
      <ul class="flex flex-col gap-2">
        {role.highlights.map((item) => (
          <li class="max-w-[60ch] text-body">{item}</li>
        ))}
      </ul>
    )}

    {role.groups && (
      <div class="grid gap-6 md:grid-cols-3">
        {role.groups.map((group) => (
          <div>
            <h4 class="font-sans text-sm font-semibold tracking-normal text-soft">{group.label}</h4>
            <ul class="mt-3 flex flex-col gap-3">
              {group.items.map((item) => (
                <li class="text-[0.95rem] leading-snug text-body">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    {role.tools && <ToolChips tools={role.tools} />}
  </div>
)}
