---
import { Icon } from 'astro-icon/components';
import RoleDetail from './RoleDetail.astro';
import { certifications } from '../../data/certifications';
import { experience, formatPeriods, startYear, type Era } from '../../data/experience';

// Del más antiguo al más reciente, de izquierda a derecha.
const chronological = [...experience].reverse();
const current = experience[0];

const nodeByEra: Record<Era, string> = {
  raw: 'border-raw text-soft',
  clean: 'border-clean text-clean',
  decide: 'border-decide text-decide',
};
---

<div data-exp-tabs class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-16">
  <div class="min-w-0">
    <h3 class="text-2xl font-extrabold">Experiencia</h3>

    <div
      role="tablist"
      aria-label="Trayectoria laboral"
      class="exp-rail -mx-5 mt-8 flex snap-x overflow-x-auto px-5 pb-4"
    >
      {chronological.map((role) => (
        <button
          type="button"
          role="tab"
          id={`tab-${role.id}`}
          aria-controls={`panel-${role.id}`}
          aria-selected={role.id === current?.id ? 'true' : 'false'}
          tabindex={role.id === current?.id ? 0 : -1}
          data-era={role.era}
          class="exp-tab group relative flex min-w-[9.5rem] shrink-0 snap-start flex-col items-start pt-9 pr-6 text-left"
        >
          <span aria-hidden="true" class="absolute top-3 right-0 left-0 h-px bg-line" />
          <span
            aria-hidden="true"
            class="exp-node absolute top-0 left-0 size-6 rounded-full border-2 bg-surface"
          />
          <span class="font-display text-2xl font-extrabold text-soft tabular-nums group-aria-selected:text-ink">
            {startYear(role)}
          </span>
          <span class="mt-1 text-sm leading-snug text-soft group-aria-selected:font-semibold group-aria-selected:text-ink">
            {role.title}
          </span>
        </button>
      ))}
    </div>

    {chronological.map((role) => (
      <section
        role="tabpanel"
        id={`panel-${role.id}`}
        aria-labelledby={`tab-${role.id}`}
        tabindex="0"
        class="exp-panel mt-4 rounded-ui border border-line bg-surface p-6 sm:p-8"
      >
        <div class="relative pb-4 pl-14 sm:pl-16">
          <span aria-hidden="true" class="absolute top-12 bottom-0 left-5 w-px bg-line" />
          <span
            aria-hidden="true"
            class="absolute bottom-0 left-[1.0625rem] size-2 rounded-full bg-line"
          />
          <span
            aria-hidden="true"
            class:list={[
              'absolute top-0 left-0 flex size-10 items-center justify-center rounded-full border-2 bg-surface',
              nodeByEra[role.era],
            ]}
          >
            <Icon name={role.icon} class="size-5" />
          </span>

          <p class="text-sm font-semibold text-soft">{formatPeriods(role.periods)}</p>
          <h4 class="mt-1 font-display text-2xl font-extrabold text-ink sm:text-3xl">
            {role.title}
          </h4>
          <p class="text-body">
            {role.org}, {role.place}
          </p>
          <RoleDetail role={role} class="mt-6" />
        </div>
      </section>
    ))}
  </div>

  <aside class="lg:sticky lg:top-24 lg:self-start">
    <h3 class="text-2xl font-extrabold">Formación</h3>
    <ul class="mt-8 flex flex-col gap-4">
      {certifications.map((item) => (
        <li class="flex gap-4 rounded-ui border border-line bg-surface p-4">
          <span
            aria-hidden="true"
            class="flex size-11 shrink-0 items-center justify-center rounded-full bg-bg text-ink"
          >
            <Icon name={item.icon} class="size-5" />
          </span>
          <div>
            <p class="leading-snug font-semibold text-ink">{item.title}</p>
            <p class="mt-1 text-sm text-body">
              {item.institution}, <span class="tabular-nums">{item.year}</span>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </aside>
</div>

<style>
  .exp-tab[data-era='raw'] {
    --era: var(--raw);
  }
  .exp-tab[data-era='clean'] {
    --era: var(--clean);
  }
  .exp-tab[data-era='decide'] {
    --era: var(--decide);
  }
  .exp-node {
    border-color: var(--era);
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .exp-tab[aria-selected='true'] .exp-node {
    background-color: var(--era);
    transform: scale(1.2);
  }
  .exp-panel:not([hidden]) {
    animation: exp-panel-in 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes exp-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp-panel:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import '../../scripts/experience-tabs';
</script>
