---
// Opción A: lista vertical con todos los puestos a la vista y el detalle al lado.
import { Icon } from 'astro-icon/components';
import Education from './Education.astro';
import RoleDetail from './RoleDetail.astro';
import { experience, formatPeriods, startYear, type Era } from '../../data/experience';

const current = experience[0];

const nodeByEra: Record<Era, string> = {
  raw: 'border-raw text-soft',
  clean: 'border-clean text-clean',
  decide: 'border-decide text-decide',
};
---

<div class="flex flex-col gap-16">
  <div data-exp-tabs>
    <h3 class="text-2xl font-extrabold">Experiencia</h3>
    <p class="mt-2 text-body">Elige un puesto para ver qué hice en cada uno.</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-10">
      <div
        role="tablist"
        aria-label="Trayectoria laboral"
        aria-orientation="vertical"
        class="relative flex flex-col lg:self-start"
      >
        <span
          aria-hidden="true"
          class="absolute top-6 bottom-6 left-[0.6875rem] w-px bg-line"
        ></span>
        <span aria-hidden="true" data-tab-indicator class="tab-indicator"></span>
        {experience.map((role) => (
          <button
            type="button"
            role="tab"
            id={`tab-${role.id}`}
            aria-controls={`panel-${role.id}`}
            aria-selected={role.id === current?.id ? 'true' : 'false'}
            tabindex={role.id === current?.id ? 0 : -1}
            data-era={role.era}
            class="exp-tab group relative flex min-h-14 items-center gap-4 rounded-ui py-2 pr-3 text-left transition-colors duration-150 hover:bg-bg aria-selected:bg-bg"
          >
            <span
              aria-hidden="true"
              class="exp-node relative z-10 size-6 shrink-0 rounded-full border-2 bg-surface"
            />
            <span class="min-w-0">
              <span class="block font-display text-lg leading-none font-extrabold text-soft tabular-nums group-aria-selected:text-ink">
                {startYear(role)}
              </span>
              <span class="mt-1 block text-sm leading-snug text-soft group-aria-selected:font-semibold group-aria-selected:text-ink">
                {role.title}
              </span>
            </span>
          </button>
        ))}
      </div>

      <div class="min-w-0">
        {experience.map((role) => (
          <section
            role="tabpanel"
            id={`panel-${role.id}`}
            aria-labelledby={`tab-${role.id}`}
            tabindex="0"
            class="exp-panel rounded-ui border border-line bg-surface p-6 sm:p-8"
          >
            <div class="flex items-start gap-4">
              <span
                aria-hidden="true"
                class:list={[
                  'flex size-10 shrink-0 items-center justify-center rounded-full border-2 bg-surface',
                  nodeByEra[role.era],
                ]}
              >
                <Icon name={role.icon} class="size-5" />
              </span>
              <div>
                <p class="text-sm font-semibold text-soft">{formatPeriods(role.periods)}</p>
                <h4 class="mt-1 font-display text-2xl font-extrabold text-ink sm:text-3xl">
                  {role.title}
                </h4>
                <p class="text-body">
                  {role.org}, {role.place}
                </p>
              </div>
            </div>
            <RoleDetail role={role} class="mt-6" />
          </section>
        ))}
      </div>
    </div>
  </div>

  <Education />
</div>

<style>
  .exp-tab[data-era='raw'] {
    --era: var(--raw);
  }
  .exp-tab[data-era='clean'] {
    --era: var(--clean);
  }
  .exp-tab[data-era='decide'] {
    --era: var(--decide);
  }
  .exp-tab {
    padding-left: 0;
  }
  .exp-node {
    border-color: var(--era);
    transition:
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
      background-color 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .exp-tab[aria-selected='true'] .exp-node {
    background-color: var(--era);
    transform: scale(1.15);
  }
  .exp-panel:not([hidden]) {
    animation: exp-panel-in 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @keyframes exp-panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .exp-panel:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import '../../scripts/experience-tabs';
</script>
