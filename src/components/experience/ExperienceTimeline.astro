---
import { Icon } from 'astro-icon/components';
import RoleDetail from './RoleDetail.astro';
import { certifications } from '../../data/certifications';
import { experience, formatPeriods, type Era } from '../../data/experience';

const nodeByEra: Record<Era, string> = {
  raw: 'border-raw text-soft',
  clean: 'border-clean text-clean',
  decide: 'border-decide text-decide',
};
---

<div class="grid gap-16 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-20">
  <div>
    <h3 class="text-2xl font-extrabold">Experiencia</h3>
    <ol class="relative mt-10">
      <span aria-hidden="true" class="absolute top-2 bottom-2 left-5 w-px bg-line"></span>
      {experience.map((role, index) => (
        <li class="relative pb-12 pl-16 last:pb-0">
          <span
            aria-hidden="true"
            class:list={[
              'absolute top-0 left-0 flex size-10 items-center justify-center rounded-full border-2 bg-surface',
              nodeByEra[role.era],
            ]}
          >
            <Icon name={role.icon} class="size-5" />
          </span>

          <div
            class:list={[
              index === 0 && 'rounded-ui border border-line bg-surface p-6 sm:p-8 -mt-2',
            ]}
          >
            <p class="text-sm font-semibold text-soft">{formatPeriods(role.periods)}</p>
            <h4
              class:list={[
                'mt-1 font-display font-extrabold text-ink',
                index === 0 ? 'text-3xl' : 'text-xl',
              ]}
            >
              {role.title}
            </h4>
            <p class="text-body">
              {role.org}, {role.place}
            </p>
            <RoleDetail role={role} class="mt-5" />
          </div>
        </li>
      ))}
    </ol>
  </div>

  <aside class="lg:sticky lg:top-24 lg:self-start">
    <h3 class="text-2xl font-extrabold">Formación</h3>
    <ul class="mt-10 flex flex-col gap-4">
      {certifications.map((item) => (
        <li class="flex gap-4 rounded-ui border border-line bg-surface p-4">
          <span
            aria-hidden="true"
            class="flex size-11 shrink-0 items-center justify-center rounded-full bg-bg text-ink"
          >
            <Icon name={item.icon} class="size-5" />
          </span>
          <div>
            <p class="leading-snug font-semibold text-ink">{item.title}</p>
            <p class="mt-1 text-sm text-body">
              {item.institution}, <span class="tabular-nums">{item.year}</span>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </aside>
</div>
